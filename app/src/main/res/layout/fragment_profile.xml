<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_normal"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF">

    <!-- 姓名和村落并排放 -->
    <LinearLayout
        android:id="@+id/layout_user_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_profile_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="姓名：张大爷"
            android:textSize="24sp"
            android:textColor="#000000"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_profile_village"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="村落：张庄村"
            android:textSize="24sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:gravity="end" />

    </LinearLayout>

    <!-- 积分 -->
    <TextView
        android:id="@+id/tv_profile_points"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="当前积分：0"
        android:textSize="22sp"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_below="@id/layout_user_info"
        android:layout_marginBottom="20dp" />

    <!-- 排行榜标题 -->
    <TextView
        android:id="@+id/tv_rank_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="同村排行榜"
        android:textSize="22sp"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_below="@id/tv_profile_points"
        android:layout_marginBottom="12dp" />

    <!-- 退出登录按钮：固定底部 -->
    <Button
        android:id="@+id/btn_profile_logout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/logout_btn_height"
        android:text="退出登录"
        android:textSize="20sp"
        android:textColor="#000000"
        android:background="@android:drawable/editbox_background"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/padding_small" />

    <!-- 排行榜列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_rank"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/btn_profile_logout"
        android:layout_below="@id/tv_rank_title"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" />

</RelativeLayout>